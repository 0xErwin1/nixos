{
  "$schema": "https://opencode.ai/config.json",
  // Without this key OpenCode resolves the default to the first non-subagent, non-hidden
  // agent, which is the built-in "build" — leaving ORCHESTRATOR.md out of the system prompt.
  "default_agent": "sdd-orchestrator",
  "plugin": [
    "@spoons-and-mirrors/subtask2@latest",
    "@warp-dot-dev/opencode-warp",
  ],
  "agent": {
    "sdd-orchestrator": {
      "model": "openai/gpt-5.6-sol",
      "description": "Primary router for direct, delegated, and SDD work",
      // "primary" (not "all") so the orchestrator can never be spawned as a sub-agent of itself.
      "mode": "primary",
      "prompt": "{file:/home/iperez/.config/opencode/ORCHESTRATOR.md}",
      "permission": {
        "question": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "bug-hunter": "allow",
          "pr-reviewer": "allow",
          "research": "allow",
          "researcher": "allow",
          "reviewer": "allow",
          "scout": "allow",
          "worker": "allow",
          "sdd-apply": "allow",
          "sdd-archive": "allow",
          "sdd-design": "allow",
          "sdd-explore": "allow",
          "sdd-init": "allow",
          "sdd-onboard": "allow",
          "sdd-propose": "allow",
          "sdd-spec": "allow",
          "sdd-tasks": "allow",
          "sdd-verify": "allow",
          "sdd-explore-testing": "allow",
          "sdd-plan-testing": "allow",
          "sdd-run-testing": "allow",
          "sdd-report-testing": "allow"
        }
      },
      "tools": {
        "bash": true,
        "delegate": true,
        "delegation_list": true,
        "delegation_read": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "question": true,
        "read": true,
        "skill": true,
        "task": true,
        "todoread": true,
        "todowrite": true,
        "webfetch": true,
        "websearch": true,
        "write": true
      }
    },
    "sdd-onboard": {
      "model": "openai/gpt-5.6-sol",
      "description": "Guide a user through an SDD cycle",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-onboard.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-apply": {
      // "model": "zai-coding-plan/glm-5.1",
      "model": "openai/gpt-5.6-terra",
      // "model": "openai/gpt-5.4",
      "description": "Implement code changes from task definitions",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-apply.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-archive": {
      // "model": "minimax/MiniMax-M2.7",
      "model": "openai/gpt-5.6-luna",
      "description": "Archive completed change artifacts",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-archive.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-design": {
      // "model": "anthropic/claude-opus-4-6",
      // "model": "zai-coding-plan/glm-5.1",
      "model": "openai/gpt-5.6-sol",
      "description": "Create technical design from proposals",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-design.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-explore": {
     // "model": "minimax/MiniMax-M2.7",
      // "model": "zai-coding-plan/glm-5.1",
      "model": "openai/gpt-5.6-luna",
      "description": "Explore codebase and think through ideas",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-explore.md}",
      // No "edit": exploration reports findings and persists its own artifact; it never
      // modifies source. "write" stays for openspec/hybrid artifact persistence.
      "tools": {
        "bash": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-init": {
      //"model": "minimax/MiniMax-M2.7",
      "model": "openai/gpt-5.6-luna",
      // "model": "zai-coding-plan/glm-5.1",
      "description": "Bootstrap SDD context and project configuration",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-init.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-propose": {
      "model": "openai/gpt-5.6-sol",
      // "model": "minimax/MiniMax-M2.7",
      // "model": "zai-coding-plan/glm-5.1",
      "description": "Create change proposals from explorations",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-propose.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-spec": {
      "model": "openai/gpt-5.6-luna",
      // "model": "zai-coding-plan/glm-5.1",
      "description": "Write detailed specifications from proposals",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-spec.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-tasks": {
      "model": "openai/gpt-5.6-luna",
      // "model": "minimax/MiniMax-M2.7",
      // "model": "zai-coding-plan/glm-5.1",
      "description": "Break down specs and designs into implementation tasks",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-tasks.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    "sdd-verify": {
      "model": "openai/gpt-5.6-sol",
      // "model": "zai-coding-plan/glm-5.1",
      "description": "Validate implementation against specs",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/sdd/sdd-verify.md}",
      // No "edit": a verifier that can patch source reports PASS on work it fixed itself,
      // which destroys the independence of the verify gate. "write" stays for openspec/hybrid
      // artifact persistence; "bash" stays because verification must run the test suites.
      "tools": {
        "bash": true,
        "fetch": true,
        "glob": true,
        "grep": true,
        "mcp": true,
        "read": true,
        "skill": true,
        "write": true
      }
    },
    // Fallback sub-agents the orchestrator is already permitted to dispatch to.
    // Model is intentionally omitted so these inherit the session default; every
    // model value above is hand-curated.
    "general": {
      "description": "General unstructured queries and auxiliary fallback tasks",
      "hidden": true,
      "mode": "subagent",
      "prompt": "You are the general fallback sub-agent. When handling unstructured auxiliary tasks:\n- Read relevant codebase context before drawing conclusions.\n- Perform empirical verification of all claims and code execution paths.\n- Keep changes minimal and targeted when editing files.\n- Do NOT launch child sub-agents autonomously.",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "task": false,
        "write": true
      }
    },
    "explore": {
      "description": "Freeform exploration fallback agent",
      "hidden": true,
      "mode": "subagent",
      "prompt": "You are the explore fallback sub-agent aligned with gentle-pi guidance.\n- Independently inspect codebase files and execution paths in full without relying on unverified assumptions.\n- Read relevant code files completely before reaching conclusions.\n- Perform exploration, analysis, and discovery ONLY. Do not create, edit, or delete files.\n- Return concise, structured findings naming affected files, code paths, and clear recommendations.",
      "tools": {
        "bash": false,
        "codegraph_codegraph_explore": true,
        "edit": false,
        "read": true,
        "task": false,
        "write": false
      }
    },
    // Review panel from gentle-ai v2.4. Model is intentionally omitted so these
    // inherit the session default; every model value above is hand-curated.
    "jd-fix-agent": {
      "description": "Surgical fix agent for judgment-day protocol",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/jd-fix-agent.md}",
      "tools": {
        "bash": true,
        "edit": true,
        "read": true,
        "write": true
      }
    },
    "jd-judge-a": {
      "description": "Adversarial code reviewer \u2014 blind judge A for judgment-day protocol",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/jd-judge-a.md}",
      "tools": {
        "*": false,
        "bash": false,
        "edit": false,
        "read": true,
        "task": false,
        "write": false
      }
    },
    "jd-judge-b": {
      "description": "Adversarial code reviewer \u2014 blind judge B for judgment-day protocol",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/jd-judge-b.md}",
      "tools": {
        "*": false,
        "bash": false,
        "edit": false,
        "read": true,
        "task": false,
        "write": false
      }
    },
    "review-readability": {
      "description": "R2 Readability reviewer \u2014 naming, complexity, intention, maintainability, review size, and context clarity",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/review-readability.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "tools": {
        "*": false,
        "bash": false,
