    },
    "review-refuter": {
      "description": "Batched adversarial refuter \u2014 evaluates every BLOCKER/CRITICAL candidate through one assigned lens and returns one verdict per finding",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/review-refuter.md}",
      "tools": {
        "*": false,
        "bash": false,
        "edit": false,
        "read": true,
        "task": false,
        "write": false
      }
    },
    "review-reliability": {
      "description": "R3 Reliability reviewer \u2014 behavior-first tests, coverage value, edge cases, determinism, contracts, and regressions",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/review-reliability.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "tools": {
        "*": false,
        "bash": false,
        "edit": false,
        "read": false,
        "task": false,
        "write": false
      }
    },
    "review-resilience": {
      "description": "R4 Resilience reviewer \u2014 fallbacks, retry/backoff, graceful degradation, observability, load, rollback, and SLO risks",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/review-resilience.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "tools": {
        "*": false,
        "bash": false,
        "edit": false,
        "read": false,
        "task": false,
        "write": false
      }
    },
    "review-risk": {
      "description": "R1 Risk reviewer \u2014 security, privilege boundaries, data exposure, dependency risks, and merge-blocking vulnerabilities",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:/home/iperez/.config/opencode/prompts/review/review-risk.md}",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "tools": {
        "*": false,
        "bash": false,
        "edit": false,
        "read": false,
        "task": false,
        "write": false
      }
    }
  },
  "mcp": {
    "aws": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "environment": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "@CONTEXT7_API_KEY@"
      }
    },
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "penpot": {
      "enabled": true,
      "type": "remote",
      "url": "https://penpot.iperez.dev/mcp/stream?userToken=@PENPOT_API_KEY@"
    },
    "dbflux": {
      "type": "local",
      "command": [
        "dbflux",
        "mcp",
        "--client-id",
        "opencode"
      ]
    },
    "engram": {
      "command": [
        "engram",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "maestro": {
      "command": [
        "maestro",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "obsidian": {
      "type": "local",
      "enabled": true,
      "command":[
        "pnpx",
        "@mauricio.wolff/mcp-obsidian@latest",
        "/home/iperez/Atlas"
      ]
    },
    "atlas": {
      "type": "remote",
      "enabled": true,
      "url": "https://atlas.iperez.dev/mcp",
      "headers": {
        "Authorization": "Bearer @ATLAS_TOKEN@"
      }
    }
  },
  // OpenCode reads permissions from the "permission" object (schema: opencode.ai/config.json).
  // A top-level "permissions" array is not in the schema and is silently ignored — which is why
  // reads of the Nix-store-backed harness files kept prompting despite a broad allow.
  // Each tool key maps glob patterns to "allow" | "ask" | "deny"; unmatched paths use the tool default.
  "permission": {
    // bash defaults to allow; ask before history-rewriting or publishing git operations.
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    // Home Manager projects the harness as symlinks that resolve into /nix/store; OpenCode checks
    // the resolved path, so the store must be allowed explicitly. "**" keeps other external reads allowed.
    "external_directory": {
      "**": "allow",
      "/nix/store/**": "allow"
    },
    // read defaults to allow; deny secret-bearing files everywhere (these override the default).
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/credentials.json": "deny",
      "**/.credentials.json": "deny",
      "**/auth.json": "deny",
      "**/.auth.json": "deny",
      "**/secrets/**": "deny"
    }
  }
}
